<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SimpitLauncher.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SimpitLauncher"
    xmlns:models="using:SimpitLauncher.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="StartButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="#2E7D32" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="28,16" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="StopButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="#C62828" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="28,16" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="EntryStartIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="#2E7D32" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="EntryStopIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="#C62828" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="10" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="StartButton"
                        Grid.Column="0"
                        Content="START"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource StartButtonStyle}"
                        Click="StartButton_Click" />
                    <Button
                        x:Name="StopButton"
                        Grid.Column="1"
                        Content="STOP"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource StopButtonStyle}"
                        Click="StopButton_Click" />
                </Grid>
                <ProgressBar
                    x:Name="RunProgressBar"
                    Minimum="0"
                    Maximum="100"
                    Value="0"
                    Height="8"
                    IsIndeterminate="False" />
                <TextBlock
                    x:Name="RunProgressText"
                    HorizontalAlignment="Left"
                    Opacity="0.75"
                    FontSize="12"
                    Text="" />
            </StackPanel>

            <Border
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Padding="12,8"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid ColumnSpacing="16" RowSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.ColumnSpan="2"
                        Text="Status"
                        FontWeight="SemiBold"
                        FontSize="12"
                        Margin="0,0,0,2"
                        Opacity="0.85" />

                    <TextBlock Grid.Row="1" Text="GPU" Opacity="0.65" FontSize="12" />
                    <TextBlock
                        x:Name="StatusGpuText"
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="…"
                        FontSize="12"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Left" />

                    <TextBlock Grid.Row="2" Text="CPU" Opacity="0.65" FontSize="12" />
                    <TextBlock
                        x:Name="StatusCpuText"
                        Grid.Row="2"
                        Grid.Column="1"
                        Text="…"
                        FontSize="12"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Left" />

                    <TextBlock Grid.Row="3" Text="Firewall" Opacity="0.65" FontSize="12" />
                    <TextBlock
                        x:Name="StatusFirewallText"
                        Grid.Row="3"
                        Grid.Column="1"
                        Text="…"
                        FontSize="12"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Left" />

                    <TextBlock Grid.Row="4" Text="Realtime Threat Scanning" Opacity="0.65" FontSize="12" />
                    <TextBlock
                        x:Name="StatusThreatText"
                        Grid.Row="4"
                        Grid.Column="1"
                        Text="…"
                        FontSize="12"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Left" />
                </Grid>
            </Border>
        </Grid>

        <SelectorBar
            x:Name="ViewSelector"
            Grid.Row="1"
            SelectionChanged="ViewSelector_SelectionChanged">
            <SelectorBarItem x:Name="TasksViewTab" Text="Tasks" Tag="tasks" IsSelected="True" />
            <SelectorBarItem x:Name="LogViewTab" Text="Log" Tag="log" />
        </SelectorBar>

        <Grid Grid.Row="2">
            <Grid
                x:Name="TasksPanel"
                RowSpacing="12"
                Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <SelectorBar
                        x:Name="ModeSelector"
                        SelectionChanged="ModeSelector_SelectionChanged">
                        <SelectorBarItem x:Name="FlightTab" Text="Flight" Tag="flight" />
                        <SelectorBarItem x:Name="RacingTab" Text="Racing" Tag="racing" />
                    </SelectorBar>

                    <Button
                        Grid.Column="1"
                        Content="Rename"
                        VerticalAlignment="Center"
                        Click="RenameMode_Click"
                        ToolTipService.ToolTip="Rename the selected profile tab" />
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Add executable" Click="AddExecutable_Click" />
                        <Button Content="Add webhook" Click="AddWebhook_Click" />
                        <Button Content="Add system option" Click="AddBuiltin_Click" />
                    </StackPanel>

                    <CheckBox
                        x:Name="StartOnLoginBox"
                        Grid.Column="1"
                        Content="Start on login"
                        Checked="StartOnLoginBox_Changed"
                        Unchecked="StartOnLoginBox_Changed" />
                </Grid>

                <ListView
                    x:Name="TaskList"
                    Grid.Row="2"
                    CanReorderItems="True"
                    CanDragItems="True"
                    AllowDrop="True"
                    SelectionMode="Single"
                    DoubleTapped="TaskList_DoubleTapped"
                    DragItemsCompleted="TaskList_DragItemsCompleted">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:TaskEntry">
                            <Grid ColumnSpacing="8" Padding="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    IsChecked="{x:Bind Enabled, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    Checked="TaskEnabled_Changed"
                                    Unchecked="TaskEnabled_Changed" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind Summary}"
                                        Opacity="0.7"
                                        FontSize="12"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Border
                                    Grid.Column="2"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    Padding="8,2"
                                    CornerRadius="4"
                                    VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind TypeLabel}" FontSize="11" />
                                </Border>

                                <Button
                                    Grid.Column="3"
                                    Content="↑"
                                    Tag="{x:Bind}"
                                    Click="MoveUp_Click"
                                    ToolTipService.ToolTip="Move up" />
                                <Button
                                    Grid.Column="4"
                                    Content="↓"
                                    Tag="{x:Bind}"
                                    Click="MoveDown_Click"
                                    ToolTipService.ToolTip="Move down" />
                                <Button
                                    Grid.Column="5"
                                    Style="{StaticResource EntryStartIconButtonStyle}"
                                    Tag="{x:Bind}"
                                    Click="EntryStart_Click"
                                    ToolTipService.ToolTip="Start this entry">
                                    <SymbolIcon Symbol="Play" Foreground="White" />
                                </Button>
                                <Button
                                    Grid.Column="6"
                                    Style="{StaticResource EntryStopIconButtonStyle}"
                                    Tag="{x:Bind}"
                                    Click="EntryStop_Click"
                                    ToolTipService.ToolTip="Stop this entry">
                                    <SymbolIcon Symbol="Stop" Foreground="White" />
                                </Button>
                                <Button
                                    Grid.Column="7"
                                    Content="Delete"
                                    Tag="{x:Bind}"
                                    Click="Delete_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid x:Name="LogPanel" Visibility="Collapsed">
                <TextBox
                    x:Name="LogBox"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    FontFamily="Consolas"
                    FontSize="12"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            </Grid>
        </Grid>
    </Grid>
</Page>
