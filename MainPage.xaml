<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FlightLauncher.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FlightLauncher"
    xmlns:models="using:FlightLauncher.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="StartButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="#2E7D32" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="28,16" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="StopButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="#C62828" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="28,16" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="160" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                <Button
                    x:Name="StartButton"
                    Content="START"
                    Style="{StaticResource StartButtonStyle}"
                    Click="StartButton_Click" />
                <Button
                    x:Name="StopButton"
                    Content="STOP"
                    Style="{StaticResource StopButtonStyle}"
                    Click="StopButton_Click" />
            </StackPanel>
            <ProgressBar
                x:Name="RunProgressBar"
                Minimum="0"
                Maximum="100"
                Value="0"
                Height="8"
                IsIndeterminate="False" />
            <TextBlock
                x:Name="RunProgressText"
                HorizontalAlignment="Center"
                Opacity="0.75"
                FontSize="12"
                Text="" />
        </StackPanel>

        <SelectorBar
            x:Name="ModeSelector"
            Grid.Row="1"
            SelectionChanged="ModeSelector_SelectionChanged">
            <SelectorBarItem x:Name="FlightTab" Text="Flight" Tag="flight" />
            <SelectorBarItem x:Name="RacingTab" Text="Racing" Tag="racing" />
        </SelectorBar>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Add executable" Click="AddExecutable_Click" />
                <Button Content="Add webhook" Click="AddWebhook_Click" />
                <Button Content="Add system option" Click="AddBuiltin_Click" />
            </StackPanel>

            <CheckBox
                x:Name="StartOnLoginBox"
                Grid.Column="1"
                Content="Start on login"
                Checked="StartOnLoginBox_Changed"
                Unchecked="StartOnLoginBox_Changed" />
        </Grid>

        <ListView
            x:Name="TaskList"
            Grid.Row="3"
            CanReorderItems="True"
            CanDragItems="True"
            AllowDrop="True"
            SelectionMode="Single"
            DoubleTapped="TaskList_DoubleTapped"
            DragItemsCompleted="TaskList_DragItemsCompleted">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:TaskEntry">
                    <Grid ColumnSpacing="8" Padding="4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox
                            IsChecked="{x:Bind Enabled, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            Checked="TaskEnabled_Changed"
                            Unchecked="TaskEnabled_Changed" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind Summary}"
                                Opacity="0.7"
                                FontSize="12"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Border
                            Grid.Column="2"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            Padding="8,2"
                            CornerRadius="4"
                            VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind TypeLabel}" FontSize="11" />
                        </Border>

                        <Button
                            Grid.Column="3"
                            Content="↑"
                            Tag="{x:Bind}"
                            Click="MoveUp_Click"
                            ToolTipService.ToolTip="Move up" />
                        <Button
                            Grid.Column="4"
                            Content="↓"
                            Tag="{x:Bind}"
                            Click="MoveDown_Click"
                            ToolTipService.ToolTip="Move down" />
                        <Button
                            Grid.Column="5"
                            Content="Delete"
                            Tag="{x:Bind}"
                            Click="Delete_Click" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="4" Text="Log" FontWeight="SemiBold" />

        <TextBox
            x:Name="LogBox"
            Grid.Row="5"
            IsReadOnly="True"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            FontFamily="Consolas"
            FontSize="12" />
    </Grid>
</Page>
