<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="FlightLauncher.Dialogs.EditTaskDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Edit task"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClick">

    <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" Padding="0,0,12,0">
            <TextBox x:Name="NameBox" Header="Name" />

            <ComboBox
                x:Name="KindBox"
                Header="Type"
                SelectionChanged="KindBox_SelectionChanged"
                HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Executable" Tag="Executable" />
                <ComboBoxItem Content="Webhook" Tag="Webhook" />
                <ComboBoxItem Content="System (built-in)" Tag="Builtin" />
            </ComboBox>

            <StackPanel x:Name="ExecutablePanel" Spacing="10">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" Header="Path (empty = stop-only)" Grid.Column="0" />
                    <Button
                        Grid.Column="1"
                        Content="Browse"
                        VerticalAlignment="Bottom"
                        Click="BrowsePath_Click" />
                </Grid>
                <TextBox x:Name="ArgsBox" Header="Arguments" />
                <CheckBox x:Name="AdminBox" Content="Run as administrator" />
                <CheckBox
                    x:Name="KillBeforeBox"
                    Content="Kill process before launching"
                    Checked="KillBeforeBox_Changed"
                    Unchecked="KillBeforeBox_Changed" />
                <CheckBox x:Name="KillBeforeForceBox" Content="Force kill before launching" Margin="24,0,0,0" />
                <TextBox x:Name="KillImageBox" Header="Kill image name(s) (comma-separated, wildcards OK)" />
                <ComboBox x:Name="StopModeBox" Header="On Stop" HorizontalAlignment="Stretch" SelectionChanged="StopModeBox_SelectionChanged">
                    <ComboBoxItem Content="None" Tag="None" />
                    <ComboBoxItem Content="Kill" Tag="Kill" />
                    <ComboBoxItem Content="Force kill" Tag="ForceKill" />
                    <ComboBoxItem Content="Command line" Tag="CommandLine" />
                </ComboBox>
                <TextBox x:Name="StopImageBox" Header="Stop image name(s) (optional override)" />
                <TextBox x:Name="StopCommandBox" Header="Stop command line" />
            </StackPanel>

            <StackPanel x:Name="WebhookPanel" Spacing="10" Visibility="Collapsed">
                <TextBox x:Name="StartUrlBox" Header="Start URL" />
                <TextBox x:Name="StopUrlBox" Header="Stop URL" />
            </StackPanel>

            <StackPanel x:Name="BuiltinPanel" Spacing="10" Visibility="Collapsed">
                <ComboBox
                    x:Name="BuiltinBox"
                    Header="System action"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="BuiltinBox_SelectionChanged">
                    <ComboBoxItem Content="Disable firewall" Tag="DisableFirewall" />
                    <ComboBoxItem Content="Disable Realtime Threat Scanning" Tag="DisableRealtimeScanning" />
                    <ComboBoxItem Content="Max CPU performance" Tag="MaxCpuPerformance" />
                    <ComboBoxItem Content="Max GPU performance" Tag="MaxGpuPerformance" />
                </ComboBox>
                <NumberBox
                    x:Name="GpuWattsBox"
                    Header="GPU start power limit (watts)"
                    Minimum="50"
                    Maximum="1000"
                    Value="352"
                    SpinButtonPlacementMode="Inline" />
                <NumberBox
                    x:Name="GpuStopWattsBox"
                    Header="GPU stop power limit (watts)"
                    Minimum="50"
                    Maximum="1000"
                    Value="200"
                    SpinButtonPlacementMode="Inline" />
                <TextBlock
                    x:Name="BuiltinHelpText"
                    TextWrapping="Wrap"
                    Opacity="0.8"
                    FontSize="12" />
            </StackPanel>

            <Border
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0"
                Margin="0,4,0,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="Test session actions" FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="TestActionHelpText"
                        TextWrapping="Wrap"
                        Opacity="0.8"
                        FontSize="12" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="TestStartButton"
                            Content="Test start action"
                            Click="TestStart_Click" />
                        <Button
                            x:Name="TestStopButton"
                            Content="Test stop action"
                            Click="TestStop_Click" />
                    </StackPanel>
                    <InfoBar
                        x:Name="TestResultBar"
                        IsOpen="False"
                        IsClosable="True"
                        Severity="Informational" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
